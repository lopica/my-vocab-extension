{
  "name": "my-vocab-extension",
  "displayName": "My vocab extension",
  "version": "0.0.1",
  "description": "save the word",
  "author": ".",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "prepare": "husky",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,scss,md}": [
      "prettier --no-stash --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.3.9",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@plasmohq/storage": "^1.15.0",
    "@tanstack/react-virtual": "^3.14.26",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "contextMenus"
    ]
  }
}
